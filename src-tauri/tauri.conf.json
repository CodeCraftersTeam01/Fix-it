{
  "$schema": "https://raw.githubusercontent.com/nicepkg/tauri-schema/main/tauri.conf.json",
  "productName": "FixIt",
  "version": "0.1.0",
  "identifier": "com.fixit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "FixIt",
        "width": 380,
        "height": 640,
        "minWidth": 340,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": true,
        "visible": true
      },
      {
        "label": "settings",
        "title": "FixIt Settings",
        "url": "index.html#settings",
        "width": 860,
        "height": 600,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
